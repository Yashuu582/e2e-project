<!DOCTYPE html>
<html>
<head>
  <title>Admin Login - FindMyStay</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="auth-page">
  <div class="auth-container">
    <div class="card" style="border:2px solid #e74c3c">
      <h1>⚠️ Admin Login</h1>
      <p style="text-align:center;color:#e74c3c;font-weight:bold;margin-bottom:15px">Restricted Area - Admin Only</p>
      <% if (error) { %><div class="error"><%= error %></div><% } %>
      <form method="POST" action="/login/admin">
        <input type="email" name="email" placeholder="Admin Email" required>
        <input type="password" name="password" placeholder="Admin Password" required>
        <button type="submit" style="background:#e74c3c">Login as Admin</button>
      </form>
      <p><a href="/">Back to Home</a></p>
    </div>
  </div>
</body>
</html>
