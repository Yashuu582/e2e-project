<!DOCTYPE html>
<html>
<head>
  <title>Admin Dashboard - FindMyStay</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="navbar admin-nav">
    <h2>⚙️ Admin Dashboard</h2>
    <div class="nav-links">
      <a href="/admin">Dashboard</a>
      <a href="/admin/hostels/pending">Pending Hostels</a>
      <a href="/admin/users">Users</a>
      <a href="/logout" class="logout">Logout</a>
    </div>
  </div>

  <div class="container wide">
    <h1>Dashboard Statistics</h1>
    <% if (error) { %><div class="error"><%= error %></div><% } %>

    <div class="stats-grid">
      <div class="stat-card"><div class="stat-number"><%= stats.totalUsers %></div><div class="stat-label">Total Users</div></div>
      <div class="stat-card verified"><div class="stat-number"><%= stats.verifiedUsers %></div><div class="stat-label">Verified Users</div></div>
      <div class="stat-card"><div class="stat-number"><%= stats.totalHostels %></div><div class="stat-label">Total Hostels</div></div>
      <div class="stat-card verified"><div class="stat-number"><%= stats.verifiedHostels %></div><div class="stat-label">Verified Hostels</div></div>
      <div class="stat-card pending"><div class="stat-number"><%= stats.pendingHostels %></div><div class="stat-label">Pending Hostels</div></div>
    </div>

    <div class="quick-actions">
      <h2>Quick Actions</h2>
      <a href="/admin/hostels/pending" class="action-btn">
        Review Pending Hostels <span class="badge"><%= stats.pendingHostels %></span>
      </a>
      <a href="/admin/users" class="action-btn">Manage Users</a>
    </div>
  </div>
</body>
</html>
