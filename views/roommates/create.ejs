<!DOCTYPE html>
<html>
<head><title>Create Profile - FindMyStay</title><link rel="stylesheet" href="/style.css"></head>
<body>
  <div class="navbar"><h2>🏠 FindMyStay</h2><div><a href="/roommates">← Back</a></div></div>
  <div class="container" style="max-width:650px">
    <div class="card" style="margin-top:30px">
      <h2 style="margin-bottom:20px">Create Roommate Profile</h2>
      <% if(error){%><div class="alert error"><%=error%></div><%}%>
      <form method="POST" action="/roommates/create">
        <h3 style="margin:15px 0 10px;color:#667eea">About You</h3>
        <div class="form-group"><textarea name="bio" placeholder="Tell about yourself" rows="3"></textarea></div>
        <div class="form-group"><input type="number" name="age" placeholder="Age" required min="18"></div>
        <div class="form-group">
          <select name="occupation" required>
            <option value="">Occupation</option>
            <option value="student">Student</option>
            <option value="working">Working Professional</option>
            <option value="other">Other</option>
          </select>
        </div>

        <h3 style="margin:15px 0 10px;color:#667eea">Budget & Location</h3>
        <div class="form-group"><input type="number" name="budgetMin" placeholder="Min Budget (₹/month)" required></div>
        <div class="form-group"><input type="number" name="budgetMax" placeholder="Max Budget (₹/month)" required></div>
        <div class="form-group"><input type="text" name="city" placeholder="Preferred City" required></div>
        <div class="form-group"><input type="text" name="areas" placeholder="Preferred Areas (comma separated)"></div>

        <h3 style="margin:15px 0 10px;color:#667eea">Preferences</h3>
        <div class="form-group">
          <select name="gender"><option value="any">Gender Preference</option><option value="male">Male</option><option value="female">Female</option><option value="any">Any</option></select>
        </div>
        <div class="form-group">
          <select name="smoking"><option value="no">Smoking</option><option value="yes">Yes</option><option value="no">No</option><option value="occasionally">Occasionally</option></select>
        </div>
        <div class="form-group">
          <select name="foodPreference"><option value="any">Food Preference</option><option value="veg">Vegetarian</option><option value="non-veg">Non-Vegetarian</option><option value="any">Any</option></select>
        </div>
        <div class="form-group">
          <select name="sleepSchedule"><option value="flexible">Sleep Schedule</option><option value="early-bird">Early Bird</option><option value="night-owl">Night Owl</option><option value="flexible">Flexible</option></select>
        </div>
        <div class="form-group">
          <select name="cleanliness"><option value="moderate">Cleanliness</option><option value="very-clean">Very Clean</option><option value="moderate">Moderate</option><option value="relaxed">Relaxed</option></select>
        </div>

        <h3 style="margin:15px 0 10px;color:#667eea">More</h3>
        <div class="form-group"><input type="text" name="interests" placeholder="Interests (comma separated)"></div>
        <div class="form-group">
          <select name="lookingFor"><option value="both">Looking For</option><option value="roommate">Roommate</option><option value="room">Room</option><option value="both">Both</option></select>
        </div>

        <button type="submit" class="btn full">Create Profile & Find Matches</button>
      </form>
    </div>
  </div>
</body>
</html>
